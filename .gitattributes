# The import contract requires UTF-8 with LF line endings. Windows checkouts must not rewrite them.
* text=auto eol=lf

*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.svg  text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf
*.wav  binary