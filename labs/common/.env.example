# Copy this file to .env in the same folder, then edit it. `.env` is gitignored on purpose:
# it is the one file that holds your machine's numbers and your secrets.
#
#     cp .env.example .env        (Linux / macOS)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# Nothing here is a password. Passwords go in the web UIs' own settings, or in a password manager.

# ---------------------------------------------------------------------------------------------
# Language. One value picks the Whisper model language, the Home Assistant language and the
# sample data folder. Nothing in the labs hard-codes English; changing this is the first step of
# the Hebrew version described in the course plan.
# ---------------------------------------------------------------------------------------------
LANG_TAG=en
TZ=UTC

# ---------------------------------------------------------------------------------------------
# Models. Sizes, licences and provenance: references/models.md
# Change these to try something else, then re-run `python homelab.py bench` and write the new
# numbers in templates/measure-yours.md. You never have to edit a lesson to use a different model.
# ---------------------------------------------------------------------------------------------
CHAT_MODEL=qwen3:4b
TOOL_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text
STT_MODEL=base
TTS_VOICE=en_US-lessac-medium

# ---------------------------------------------------------------------------------------------
# Memory limits. These are the single most important numbers in the file on a small machine.
# Total them; they must leave room for the operating system and your browser.
# Tier A (16 GB): the defaults below add up to 20 GB, which is too much - lower them:
#   OLLAMA_MEMORY_LIMIT=7g
#   WEBUI_MEMORY_LIMIT=1g
#   HA_MEMORY_LIMIT=1g
#   WHISPER_MEMORY_LIMIT=1g
#   PIPER_MEMORY_LIMIT=512m
# Module 2 works out the right numbers for you from your own measurements.
# ---------------------------------------------------------------------------------------------
OLLAMA_MEMORY_LIMIT=12g
WEBUI_MEMORY_LIMIT=2g
HA_MEMORY_LIMIT=2g
WHISPER_MEMORY_LIMIT=2g
PIPER_MEMORY_LIMIT=1g
QDRANT_MEMORY_LIMIT=1g

# ---------------------------------------------------------------------------------------------
# Ports. The chat interface is the only published port, and it binds to loopback.
# Reading this line without understanding it is how people expose a model server to the internet.
# Module 11 changes it, on purpose, and explains what you just gave away.
# ---------------------------------------------------------------------------------------------
WEBUI_BIND=127.0.0.1

# ---------------------------------------------------------------------------------------------
# Remote access (Module 11). WireGuard and Tailscale are set up OUTSIDE this file - on the host
# or on your router. Docker is not involved, and that is the point: there is no port to forward.
# ---------------------------------------------------------------------------------------------
# VPN_PROVIDER=wireguard
